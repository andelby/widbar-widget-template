<hosting:WidgetHostApplication
    x:Class="WidBarCompanion1.Widget.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="using:WidBar.SDK.Hosting"
    xmlns:sdk="using:WidBar.SDK">
    <hosting:WidgetHostApplication.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- The hover and pressed plate of the taskbar's own buttons. -->
                <sdk:TaskbarButtonResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </hosting:WidgetHostApplication.Resources>
</hosting:WidgetHostApplication>
